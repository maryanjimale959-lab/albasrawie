# Copy to .env.local
#
# DATABASE — MySQL or MariaDB. The app creates and upgrades its own tables on the
# first run, so all it needs is an existing database and a user that can write to it.
#
# Option 1: one connection URL. Railway, PlanetScale and most hosting panels give you
# this as DATABASE_URL; either name works, and MYSQL_URL wins if both are set.
MYSQL_URL=mysql://user:password@127.0.0.1:3306/albasrawie
#
# Option 2: the parts, used when no URL is set.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=albasrawie
MYSQL_PASSWORD=
MYSQL_DATABASE=albasrawie
#
# Connections one server process may hold open (optional, default 10).
MYSQL_POOL_SIZE=10
#
# EMAIL — the mailbox that sends sign-up codes. Every new student and teacher confirms
# their email with a 6-digit code, then waits for an administrator to approve them.
# Port 465 uses SSL; 587 uses STARTTLS. SMTP_SECURE overrides that guess if needed.
# Without SMTP_HOST, `npm run dev` prints the code to the terminal; production refuses.
SMTP_HOST=mail.example.com
SMTP_PORT=465
SMTP_USER=no-reply@example.com
SMTP_PASSWORD=
MAIL_FROM="Albasrawie <no-reply@example.com>"
#
# Used by `npm run seed` to create the first platform administrator.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now
#
# Existing SQLite install? Move it across with:
#   npm run migrate:mysql -- --from data/albasrawie.db
# It reads the .db file with the settings above and re-writes every table in place.
